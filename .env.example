# ---------------------------------------------------------------
# HRAPP environment variables
# Copy to .env.local for local dev; set the same keys in Vercel
# (Production + Preview) before deploying. No values are committed.
# ---------------------------------------------------------------

# --- Supabase ---------------------------------------------------
# Project ref: pknfmxterwvpctexjdkr
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. Used in lib/supabase/admin.ts
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---------------------------------------------------------
# Public base URL, no trailing slash, e.g. https://hr.baytify.com
# Used to build offer, onboarding and scheduling links in emails.
# Falls back to http://localhost:3000 if unset - links WILL be broken.
NEXT_PUBLIC_APP_URL=

# Shared secret for Vercel Cron. Generate: openssl rand -base64 32
# Must be set, or the cron routes accept "Bearer undefined".
CRON_SECRET=

# AES-256 key for encrypting asset passwords (lib/vaultCrypto.ts).
# Base64 that decodes to exactly 32 bytes. Generate: openssl rand -base64 32
# WARNING: changing this makes existing encrypted asset secrets unreadable.
ASSET_VAULT_KEY=

# --- Email (Resend) ----------------------------------------------
RESEND_API_KEY=
# Verified sender for internal/employee mail
RESEND_FROM_EMAIL=
# Verified sender for candidate-facing mail
RESEND_FROM_EMAIL_CANDIDATE=
# Internal recipient for onboarding/system notifications
NOTIFY_EMAIL=

# --- Recruitment inbox (IMAP sync, cron: check-inbox) ------------
RECRUITMENT_EMAIL=
# App-specific password, not the account password
RECRUITMENT_EMAIL_PASSWORD=
RECRUITMENT_IMAP_HOST=
RECRUITMENT_IMAP_PORT=993

# --- PandaDoc (e-signature, cron: pandadoc-sync) -----------------
PANDADOC_API_KEY=
PANDADOC_WEBHOOK_SECRET=

# --- Zoom (interview scheduling, Server-to-Server OAuth) ---------
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Email of the Zoom user meetings are created under
ZOOM_HOST_EMAIL=
